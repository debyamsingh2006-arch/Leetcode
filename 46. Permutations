#include <vector>
#include <algorithm>

using namespace std;

class Solution {
public:
    vector<vector<int>> permute(vector<int>& nums) {
        vector<vector<int>> result;
        backtrack(0, nums, result);
        return result;
    }

private:
    void backtrack(int index, vector<int>& nums, vector<vector<int>>& result) {
        // Base case: all positions are fixed
        if (index == nums.size()) {
            result.push_back(nums);
            return;
        }

        for (int i = index; i < nums.size(); ++i) {
            // Fix the i-th element at the current index
            swap(nums[index], nums[i]);
            
            // Recurse for the remaining positions
            backtrack(index + 1, nums, result);
            
            // Backtrack: undo the swap to restore the original order
            swap(nums[index], nums[i]);
        }
    }
};
