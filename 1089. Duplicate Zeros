#include <vector>
#include <algorithm>

class Solution {
public:
    void duplicateZeros(std::vector<int>& arr) {
        int n = arr.size();
        int zeros = std::count(arr.begin(), arr.end(), 0);
        
        // i points to the end of the original array
        // j points to the theoretical end of the expanded array
        int i = n - 1;
        int j = n + zeros - 1;
        
        while (i < j) {
            if (j < n) {
                arr[j] = arr[i];
            }
            
            // If the current element is 0, write it a second time
            if (arr[i] == 0) {
                j--;
                if (j < n) {
                    arr[j] = 0;
                }
            }
            
            i--;
            j--;
        }
    }
};
